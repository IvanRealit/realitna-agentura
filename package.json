{
  "name": "realitna-agentura",
  "version": "1.0.0",
  "description": "Website for a real estate agency in Slovakia.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --import tsx scripts/test-runner.ts e2e",
    "db:generate": "node --import tsx scripts/generate-client.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "data:purge": "node --import tsx scripts/purge.ts",
    "format:check": "prettier --check .",
    "test:prepare": "node --import tsx scripts/test-runner.ts prepare",
    "db:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "test:bootstrap": "node --import tsx scripts/test-runner.ts bootstrap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanRealit/realitna-agentura.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/IvanRealit/realitna-agentura/issues"
  },
  "homepage": "https://github.com/IvanRealit/realitna-agentura#readme",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@prisma/client-generator-registry": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
