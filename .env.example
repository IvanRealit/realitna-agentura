APP_ENV=demo
POSTGRES_PASSWORD=development-only
DATABASE_URL=postgresql://realitna:development-only@localhost:5432/realitna?schema=public
SITE_URL=http://localhost:3000
# First owner via npm run db:bootstrap (seed never creates accounts).
# Generate a strong unique password locally, remove these after bootstrap.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local single-instance storage; use a persistent volume in production.
UPLOAD_DIR=data/uploads
# Trusted reverse proxy must replace x-forwarded-for before enabling.
TRUST_PROXY=false
# Set to true only with HTTPS. Next production defaults to secure cookies.
COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1

# Isolated test database only (separate Compose service, never production).
TEST_DATABASE_URL=postgresql://realitna:test-only-db@127.0.0.1:55432/realitna_test
TEST_BASE_URL=http://127.0.0.1:3101

# 32 random bytes as 64 hex characters; generate securely, keep outside Git.
# Required before enrolling MFA; preserve securely for recovery.
MFA_ENCRYPTION_KEY=
